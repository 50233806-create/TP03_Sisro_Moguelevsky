@{
    ViewData["Title"] = "Ahorcado";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />

    <title>Ahorcado</title>
</head>
<body>
    <header>
        <h1>Ahorcado</h1>
        <p>El iconico juego de adivinanza con un cambio cinematografico, las palabras a adivinar son todas titulos de peliculos que solo consisten en una sola palabra. Arriega tus intentos y letras para no ser el verdadero ahorcado</p>    
    </header>
    <section>
        <div>
        <p id="msj"></p>
            @for (int i = 0; i < @ViewBag.Palabra.length; i++)
            {
                <p>_</p>
            }
        </div>
        <p id="intentos">Intentos restantes:</p>
        <div>
        <p id="mensaje">Estado: </p>    
        </div>
        <input type="text" name ="letra" placeholder="Ingresar Letra" id="letra">
        <input type="hidden" name="palabraOculta" placeholder="Ingresar Palabra" id="palabraOculta">
        <button>
            <input type="submit" value="Arriesgar letra">
        </button>
    </section>
</body>
    
